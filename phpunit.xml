<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- SQLiteではなくMySQLで実行する。本番と同じ照合順序・unique制約のNULL挙動に
             依存しているため(docs/detailed-design.md 16.2)。開発用DBと分離するため
             DB_DATABASEは専用の booking_testing を指す(docker/mysql/init.sqlが作成)。 -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="db"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="booking_testing"/>
        <env name="DB_USERNAME" value="booking"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- 実 API は叩かず Http::fake() で差し替える前提のダミー値。
             未設定だと ShopifyClient の baseUrl が不正な URI になり、
             Http::fake() が効く前に MalformedUriException で落ちるため必須。 -->
        <env name="SHOPIFY_SHOP_DOMAIN" value="test-shop.myshopify.com"/>
        <env name="SHOPIFY_ACCESS_TOKEN" value="test-access-token"/>
        <env name="SHOPIFY_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <env name="SHOPIFY_API_VERSION" value="2026-01"/>
        <env name="SHOPIFY_LOCATION_ID" value="gid://shopify/Location/1"/>
        <!-- demo:reset は最大22枠(15日x1〜2枠)を生成するため、それを上回る数を用意する -->
        <env name="BOOKING_DEMO_SLOT_VARIANT_IDS" value="gid://shopify/ProductVariant/1,gid://shopify/ProductVariant/2,gid://shopify/ProductVariant/3,gid://shopify/ProductVariant/4,gid://shopify/ProductVariant/5,gid://shopify/ProductVariant/6,gid://shopify/ProductVariant/7,gid://shopify/ProductVariant/8,gid://shopify/ProductVariant/9,gid://shopify/ProductVariant/10,gid://shopify/ProductVariant/11,gid://shopify/ProductVariant/12,gid://shopify/ProductVariant/13,gid://shopify/ProductVariant/14,gid://shopify/ProductVariant/15,gid://shopify/ProductVariant/16,gid://shopify/ProductVariant/17,gid://shopify/ProductVariant/18,gid://shopify/ProductVariant/19,gid://shopify/ProductVariant/20,gid://shopify/ProductVariant/21,gid://shopify/ProductVariant/22,gid://shopify/ProductVariant/23,gid://shopify/ProductVariant/24,gid://shopify/ProductVariant/25"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
